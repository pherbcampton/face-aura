# Local open-weight vision model (Ollama + Gemma 4 E4B)
OLLAMA_URL=http://127.0.0.1:11434
GEMMA_MODEL=gemma4:e4b

# Production alternative (Ollama Cloud keeps the same API; the key stays server-side):
# OLLAMA_URL=https://ollama.com
# GEMMA_MODEL=gemma4:cloud
OLLAMA_API_KEY=

# Safe hackathon fallback. Set false in production so inference failures are explicit.
ALLOW_DEMO_ANALYSIS=true

# Supabase Auth + private per-user data. The publishable key is safe for the browser;
# row-level security in supabase/migrations protects each user's records.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Keep false for an anonymous hackathon demo. Set true for production after
# Supabase and Google OAuth are configured.
REQUIRE_AUTH=false

# ElevenLabs ElevenAgents. The key stays server-side.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
VITE_ELEVENLABS_AGENT_ID=

# Server
PORT=8787
